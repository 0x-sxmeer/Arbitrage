# ═══════════════════════════════════════════════════════════════════════════════
#  .env — MEV Engine v2 Configuration (Phases 1-4)
#  Add these NEW variables to your existing .env file.
#  All existing variables remain unchanged.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── EXECUTION GATE (keep false until fully tested) ───────────────────────────
EXECUTE_ENABLED=false

# ─── EXISTING VARIABLES (keep as-is) ─────────────────────────────────────────
# ETH_WS_URL=wss://...
# ETH_HTTP_URL=https://...
# BASE_WS_URL=wss://...
# BASE_HTTP_URL=https://...
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://...
# PRIVATE_KEY=0x...
# CONTRACT_ADDRESS=0x...
# MIN_PROFIT_USD=1.0
# GAS_PRICE_GWEI=0.01
# ETH_PRICE_USD=3000.0

# ─── NEW: Aave + Balancer flash loans (Phase 1) ───────────────────────────────
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
FLASHBOTS_SIGNING_KEY=0x_SEPARATE_KEY_NOT_EXECUTION_KEY
MAX_DRAWDOWN_PER_HOUR_ETH=0.5

# ─── NEW: CEX-DEX (Phase 2) ───────────────────────────────────────────────────
CEX_DEX_ENABLED=false
CEX_DEX_MIN_SPREAD_PCT=0.15
CEX_DEX_LOAN_SIZE_USD=500000
# Binance API (for hedge order placement — read from WS is free without key)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET

# ─── NEW: Backrunning + Liquidations (Phase 3) ────────────────────────────────
BACKRUN_ENABLED=false
BACKRUN_MIN_IMPACT_BPS=20
LIQUIDATIONS_ENABLED=false
LIQUIDATION_MIN_PROFIT_USD=20.0
# Private mempool feed (Bloxroute for early tx detection)
PRIVATE_RPC_URL=https://mev.api.blxrbdn.com
BLOXROUTE_API_KEY=YOUR_BLOXROUTE_KEY

# ─── NEW: Cross-Chain Arbitrage (Phase 4) ─────────────────────────────────────
CROSS_CHAIN_ENABLED=false
CROSS_CHAIN_TRADE_SIZE_USD=50000
CROSS_CHAIN_MIN_USDC=20000

# Optimism RPC (for Phase 4)
OP_WS_URL=wss://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
OP_HTTP_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum RPC (for Phase 4)
ARB_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_HTTP_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract addresses on other chains (after deploying AtomicArbV2)
CONTRACT_ADDRESS_OPTIMISM=0x_DEPLOY_THEN_FILL
CONTRACT_ADDRESS_ARBITRUM=0x_DEPLOY_THEN_FILL

# ─── ROLLOUT SCHEDULE (enable one phase per week) ─────────────────────────────
# Week 1: EXECUTE_ENABLED=true (Phase 1 DEX-DEX only)
# Week 2: CEX_DEX_ENABLED=true (Phase 2 added)
# Week 3: BACKRUN_ENABLED=true + LIQUIDATIONS_ENABLED=true (Phase 3)
# Week 4: CROSS_CHAIN_ENABLED=true (Phase 4)
