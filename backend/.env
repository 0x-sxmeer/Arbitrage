# CONTRACT_ADDRESS_ARBITRUM=0x_ARB_DEPLOYED_ADDRESS

# ── Market Data ───────────────────────────────────────────────────────────────
BTC_PRICE_USD=95000.0

# ── Circuit Breaker ───────────────────────────────────────────────────────────
MAX_DRAWDOWN_PER_HOUR_ETH=0.5
