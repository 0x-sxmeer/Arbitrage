# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Complete environment configuration template
#
#  Copy this file to .env and fill in all required values.
#  NEVER commit .env to git — it contains private keys!
# ─────────────────────────────────────────────────────────────────────────────

# ============= NETWORK =============
# Chain ID: 1 = Ethereum Mainnet, 11155111 = Sepolia, 8453 = Base
CHAIN_ID=8453

# Ethereum WebSocket & HTTP RPC endpoints (Infura)
ETH_WS_URL=wss://base-rpc.publicnode.com
ETH_HTTP_URL=https://mainnet.base.org

# Base L2 WebSocket & HTTP (dRPC public)
BASE_WS_URL=wss://base-rpc.publicnode.com
BASE_HTTP_URL=https://mainnet.base.org

# Arbitrum WebSocket (optional)
# ARB_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Solana RPC (optional)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# ============= KEYS =============
# DO NOT COMMIT THIS FILE!
# Execution wallet private key (hex, 64 chars, optional 0x prefix)
PRIVATE_KEY=0xd085732cea8f33eefca7fca0d38faf3b514fe54681d03748e0068644773354a8

# Flashbots signing key (separate EOA — NOT the execution wallet — not used on Base)
# FLASHBOTS_SIGNING_KEY=0xf581f79e73623bfd2df4351c71c3a46c6966de260003241ef9983a08989e2810

# ============= CONTRACTS =============
# Address of deployed AtomicArb contract (fill after deployment)
CONTRACT_ADDRESS="0x30f638c8F84517bCdCf6d1e3456bb4A235c2C6b7"

# Sepolia Aave V3 Pool (official)
# AAVE_POOL_ADDRESS=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
# Sepolia Uniswap V3 SwapRouter
# UNISWAP_V3_ROUTER=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48
# Sepolia Uniswap V2 Router
# UNISWAP_V2_ROUTER=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008

# ============= DATABASE =============
DATABASE_URL=postgresql://arb_user:arb_password@localhost:5432/arb_engine

# ============= REDIS =============
REDIS_URL=redis://127.0.0.1:6379

# ============= FLASHBOTS =============
# Sepolia: https://relay-sepolia.flashbots.net
# Mainnet: https://relay.flashbots.net
# FLASHBOTS_RPC_URL=https://relay-sepolia.flashbots.net

# ============= BOT SETTINGS =============
# Minimum net profit in USD to execute a trade
MIN_PROFIT_USD=0

# Maximum price impact in basis points before aborting
# 200 bps = 2% — broad enough to catch real multi-hop arbs on liquid pools
MAX_PRICE_IMPACT_BPS=200

# Maximum hops in arbitrage cycle (1-6)
MAX_HOPS=4

# Maximum pool state staleness in blocks
MAX_BLOCK_STALENESS=2

# Maximum trade size as fraction of pool reserves (0.01 = 1%)
MAX_TRADE_SIZE_PCT=0.01

# ETH price in USD (used for gas cost normalization) — update this manually or via oracle
ETH_PRICE_USD=2500.0

# Current effective gas price in gwei (Base L2 gas is usually ~0.001 gwei)
GAS_PRICE_GWEI=0.001

# Maximum gas price in gwei (optional safety cap)
MAX_GAS_PRICE_GWEI=50

# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# ============= LOGGING =============
# Set RUST_LOG for log verbosity
RUST_LOG=trace

# Set to "json" for structured JSON logs (production)
# LOG_FORMAT=json

# ============= EXECUTION GATE =============
# SAFETY: Set to "true" ONLY when you are ready for live on-chain execution.
# When false (default), the engine runs in MONITORING ONLY mode:
#   - Detects profitable opportunities ✅
#   - Runs eth_call dry-run simulations ✅
#   - Logs PGA gas bids ✅
#   - Does NOT broadcast any transaction ❌
#
# Steps to go live:
#   1. Run: forge script script/SetupRouters.s.sol --rpc-url $BASE_HTTP_URL --private-key $PRIVATE_KEY --broadcast
#   2. Fund the PRIVATE_KEY wallet with at least 0.01 ETH on Base for gas
#   3. Verify simulations are passing in the logs (✅ Dry-run simulation PASSED)
#   4. Set EXECUTE_ENABLED=true below
EXECUTE_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
#  MEV ENGINE v2 — Phase 2-4 Configuration
#  All phases default to DISABLED for safety. Enable one at a time after testing.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Phase 1 additions: Dual Flash Loan Sources ───────────────────────────────
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# Balancer V2 Vault — same address on ALL EVM chains (0% fee flash loans)
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# ── MEV Infrastructure ───────────────────────────────────────────────────────
FLASHBOTS_RPC_URL=https://relay.flashbots.net
# FLASHBOTS_SIGNING_KEY=0x_YOUR_FLASHBOTS_SIGNING_KEY
# PRIVATE_RPC_URL=https://mev.api.blxrbdn.com
# BLOXROUTE_API_KEY=YOUR_BLOXROUTE_KEY

# ── Phase 2: CEX-DEX Statistical Arbitrage ──────────────────────────────────
CEX_DEX_ENABLED=True
CEX_DEX_MIN_SPREAD_PCT=0.15
CEX_DEX_LOAN_SIZE_USD=500000
CEX_DEX_MAX_INVENTORY_USD=100000
CEX_DEX_SYMBOLS=ETHUSDT,BTCUSDT,AAVEUSDT,UNIUSDT,LINKUSDT,ARBUSDT
# BINANCE_API_KEY=YOUR_BINANCE_API_KEY
# BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET

# ── Watchlists ────────────────────────────────────────────────────────────────
WATCH_TOKENS_BASE="WETH=0x4200000000000000000000000000000000000006,cbBTC=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf,USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,AERO=0x940181a94A35A4569E4529A3CDfB74e38FD98631,AAVE=0x63706e401c06ac8513a53fEcB60F13dA1C72B9A2,msETH=0x7Ba6F01772924a82D9626c126347A28299E9d858,WELL=0xFF8adeC2221f9f4D8dfbAFa6B9a297d17603493D"

WATCH_TOKENS_ARB="WETH=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1,USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831,WBTC=0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f,ARB=0x912CE59144191C1204E64559FE8253a0e49E6548,GMX=0xfc5A1A6EB076a2C7aD06eD22C90d7E710E35ad0a,LINK=0xf97f4df75117a78c1A5a0DBb814Af92458539FB4"

# ── Phase 3: Backrunning ─────────────────────────────────────────────────────
BACKRUN_ENABLED=True
BACKRUN_MIN_IMPACT_BPS=20
BACKRUN_MIN_PROFIT_USD=10.0

# ── Phase 3: Liquidations ────────────────────────────────────────────────────
LIQUIDATIONS_ENABLED=True
LIQUIDATION_MIN_PROFIT_USD=20.0
MOONWELL_COMPTROLLER=0xfBb21d0380beE3312B33c4353c8936a0F13EF26C

# ── Phase 4: Cross-Chain Arbitrage (Base <-> Optimism <-> Arbitrum) ──────────
CROSS_CHAIN_ENABLED=True
CROSS_CHAIN_MIN_SPREAD_PCT=0.30
CROSS_CHAIN_TRADE_SIZE_USD=50000
CROSS_CHAIN_MIN_USDC_RESERVE=20000
# OP_WS_URL=wss://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# OP_HTTP_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# ARB_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# ARB_HTTP_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
