# ═══════════════════════════════════════════════════════════════════════════════
#  .env.example — MEV Engine v2 Configuration (Phases 1-4)
#  Copy to .env and fill in all REQUIRED fields before running.
# ═══════════════════════════════════════════════════════════════════════════════

# ── EXECUTION GATE (safety — start false, enable after testing) ───────────────
EXECUTE_ENABLED=false

# ── PHASE 1: Core EVM + Flash Loans ─────────────────────────────────────────

# Base L2 (PRIMARY — cheapest gas, Aave V3 deployed)
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_HTTP_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Ethereum mainnet (fallback)
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── PHASE 1: Dual Flash Loan Sources ────────────────────────────────────────
# Aave V3 Pool on Base
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# Balancer V2 Vault on Base (0% fee flash loans)
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# ── PHASE 1: Execution Wallet ────────────────────────────────────────────────
# Main execution wallet (signs arb txs)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
# AtomicArbV2 contract address (after deployment)
CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS

# ── MEV Infrastructure ───────────────────────────────────────────────────────
# Flashbots relay (use Base Flashbots for L2)
FLASHBOTS_RPC_URL=https://relay.flashbots.net
# Separate Flashbots signing key (NOT the execution wallet)
FLASHBOTS_SIGNING_KEY=0x_SEPARATE_FLASHBOTS_KEY
# Private RPC for mempool access (Bloxroute / Chainbound)
PRIVATE_RPC_URL=https://mev.api.blxrbdn.com
# Bloxroute API key (for private mempool feed)
BLOXROUTE_API_KEY=YOUR_BLOXROUTE_KEY

# ── Database ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://arb:arb_password@localhost:5432/arb_db

# ── Arb Parameters ───────────────────────────────────────────────────────────
MIN_PROFIT_USD=1.0
MAX_PRICE_IMPACT_BPS=200
MAX_HOPS=4
MAX_BLOCK_STALENESS=5
MAX_TRADE_SIZE_PCT=0.01
GAS_PRICE_GWEI=0.01

# ── Market Data ──────────────────────────────────────────────────────────────
ETH_PRICE_USD=3000.0
BTC_PRICE_USD=95000.0

# ── PHASE 2: CEX-DEX Statistical Arbitrage ──────────────────────────────────
# Binance API credentials (for order placement / hedge)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET
# Binance WebSocket (auto-configured — no key needed for public feeds)
BINANCE_WS_URL=wss://fstream.binance.com

# CEX-DEX engine config
CEX_DEX_ENABLED=false
CEX_DEX_MIN_SPREAD_PCT=0.15
CEX_DEX_LOAN_SIZE_USD=500000
CEX_DEX_MAX_INVENTORY_USD=100000
# Symbols to track (comma-separated, must match Binance perp symbols)
CEX_DEX_SYMBOLS=ETHUSDT,BTCUSDT,WBTCUSDT

# ── PHASE 3: Advanced Mempool MEV ────────────────────────────────────────────
# Enable backrunning strategy
BACKRUN_ENABLED=false
BACKRUN_MIN_IMPACT_BPS=20
BACKRUN_MIN_PROFIT_USD=10.0

# Enable liquidation strategy
LIQUIDATIONS_ENABLED=false
LIQUIDATION_MIN_PROFIT_USD=20.0
# Protocols to monitor (comma-separated)
LIQUIDATION_PROTOCOLS=aave_v3,moonwell

# Moonwell Comptroller on Base
MOONWELL_COMPTROLLER=0xfBb21d0380beE3312B33c4353c8936a0F13EF26C

# ── PHASE 4: Cross-Chain Arbitrage ───────────────────────────────────────────
CROSS_CHAIN_ENABLED=false
CROSS_CHAIN_MIN_SPREAD_PCT=0.30
CROSS_CHAIN_TRADE_SIZE_USD=50000

# Optimism RPC
OP_WS_URL=wss://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
OP_HTTP_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum RPC
ARB_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_HTTP_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# AtomicArbV2 deployed on each chain
CONTRACT_ADDRESS_OPTIMISM=0x_OP_CONTRACT
CONTRACT_ADDRESS_ARBITRUM=0x_ARB_CONTRACT

# Cross-chain inventory (minimum per chain to maintain)
CROSS_CHAIN_MIN_USDC_RESERVE=20000
CROSS_CHAIN_MIN_ETH_RESERVE=2.0

# ── Circuit Breaker ───────────────────────────────────────────────────────────
# Max net loss per hour in wei before auto-pause (1 ETH = 1000000000000000000)
MAX_DRAWDOWN_PER_HOUR_ETH=0.5
