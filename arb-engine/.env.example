# ─────────────────────────────────────────────────────────────────────────────
#  Cross-Chain Arbitrage Engine — Environment Configuration
#  Copy this to .env and fill in your keys. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ethereum RPC ──────────────────────────────────────────────────────────────
# WebSocket for mempool + event subscriptions (Alchemy / Infura / private Geth)
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# HTTP fallback for read queries
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Layer 2 RPC ───────────────────────────────────────────────────────────────
BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARB_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Solana RPC ────────────────────────────────────────────────────────────────
# Helius recommended for speed (< 5ms vs public RPC ~100ms)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://arb_user:arb_password@localhost:5432/arb_engine
REDIS_URL=redis://localhost:6379

# ── Execution Wallet ──────────────────────────────────────────────────────────
# The EOA that signs and submits arbitrage transactions
# NEVER commit this key — use a hardware wallet or KMS in production
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── MEV Protection ────────────────────────────────────────────────────────────
# Flashbots RPC (private mempool, no front-running)
FLASHBOTS_RPC_URL=https://relay.flashbots.net
# Flashbots signing key (can be any EOA, separate from execution wallet)
FLASHBOTS_SIGNING_KEY=0xYOUR_FLASHBOTS_SIGNING_KEY

# ── Oracle / Price Feeds ──────────────────────────────────────────────────────
# CoinGecko for ETH price (gas cost USD normalization)
COINGECKO_API_KEY=YOUR_COINGECKO_KEY

# ── Arbitrage Parameters ──────────────────────────────────────────────────────
# Minimum NEV in USD to execute (safety margin above gas variance)
MIN_PROFIT_USD=0.50
# Maximum trade size as % of pool reserves (slippage guard)
MAX_TRADE_SIZE_PCT=0.01
# Maximum price impact in basis points before aborting (30 = 0.3%)
MAX_PRICE_IMPACT_BPS=30
# Max staleness: reject pool state older than N blocks
MAX_BLOCK_STALENESS=2

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to debug for verbose output during development
RUST_LOG=arb_engine=info,warn
